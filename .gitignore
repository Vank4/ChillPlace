# ------------------------------
# Dependencies
# ------------------------------
**/node_modules/
.pnpm-store/

# ------------------------------
# Environment files
# ------------------------------
.env
.env.*
!.env.example
!.env.*.example

# ------------------------------
# Build / cache artifacts
# ------------------------------
dist/
build/
coverage/
.cache/
.parcel-cache/
.vite/
**/.next/
**/.nuxt/
**/.svelte-kit/
*.tsbuildinfo

# ------------------------------
# Logs / diagnostics
# ------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------
# Runtime / temp files
# ------------------------------
tmp/
temp/
*.tmp
*.pid
*.pid.lock
.DS_Store
Thumbs.db

# ------------------------------
# IDE / editor
# ------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ------------------------------
# App-specific (ChillPlace)
# ------------------------------
# Local uploads for API
apps/api/uploads/
uploads/

# Prisma local engine/cache noise
prisma/.tmp/
prisma/dev.db*

# Keep migration history, ignore ad-hoc helper SQL files
prisma/migrations/**/migration_apply_*.sql

